{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "site"
      ],
      "port": 8765
    },
    {
      "name": "vercel",
      "runtimeExecutable": "vercel",
      "runtimeArgs": [
        "dev",
        "--listen",
        "3333",
        "--yes"
      ],
      "port": 3333
    }
  ]
}

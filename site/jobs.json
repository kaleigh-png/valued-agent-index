{
  "version": "1.0",
  "note": "Function-first map of the jobs people hand to agents. Industries are tags, not a level. Job wording follows O*NET task style; functions follow the common cross-industry process groupings. Edit here, never in site/.",
  "industries": [
    "Defense & GovCon",
    "Insurance",
    "Banking & credit unions",
    "Healthcare",
    "Legal",
    "Staffing & recruiting",
    "Nonprofit & public sector",
    "Real estate",
    "Retail & e-commerce",
    "Manufacturing & logistics",
    "Education",
    "Professional services",
    "Software",
    "Personal"
  ],
  "functions": [
    "Sales & marketing",
    "Customer support",
    "Finance & accounting",
    "HR & recruiting",
    "Operations & admin",
    "Legal, compliance & risk",
    "Proposals, grants & procurement",
    "IT & security operations",
    "Research & analysis",
    "Healthcare & clinical",
    "Education",
    "Property",
    "Personal life"
  ],
  "jobs": [
    {
      "id": "find-leads",
      "function": "Sales & marketing",
      "name": "Find and qualify leads",
      "match": "lead (gen|generation)|\\bleads\\b|prospect\\w*|lead list"
    },
    {
      "id": "outreach",
      "function": "Sales & marketing",
      "name": "Cold outreach and follow-ups",
      "match": "cold (email|outreach|call)|\\boutreach\\b|follow-?ups?|sequences?|warm intro"
    },
    {
      "id": "crm",
      "function": "Sales & marketing",
      "name": "Keep the CRM and pipeline current",
      "match": "\\bcrm\\b|sales pipeline|deal notes|pipeline"
    },
    {
      "id": "content",
      "function": "Sales & marketing",
      "name": "Run social, content and campaigns",
      "match": "social media|content calendar|newsletters?|\\bseo\\b|campaigns?|\\bmarketing\\b|blog posts?|linkedin posts?"
    },
    {
      "id": "support-tickets",
      "function": "Customer support",
      "name": "Answer support tickets and chats",
      "match": "customer (support|service)|help ?desk|support tickets?|support desk|live chat|chatbot for customers"
